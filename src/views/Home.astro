---
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.astro';
import TripCard from '../components/TripCard.astro';
import EntryList from '../components/EntryList.astro';
import Photo from '../components/Photo.astro';
import { getTrips, getEntries, buildMapData, pick, md, site } from '../lib/content';
import { path, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';

const trips = await getTrips();
const entries = await getEntries();
const mapData = buildMapData(trips, entries, lang, { withPlaces: true });
// Deutsche Links auf der englischen Seite automatisch umschreiben
const localize = (href: string) => {
  if (lang === 'de' || !href.startsWith('/') || href.startsWith('/en/')) return href;
  return '/en' + href.replace(/^\/reisen\//, '/trips/').replace(/^\/tagebuch\//, '/diary/').replace(/^\/karte\//, '/map/').replace(/^\/ueber-uns\//, '/about/');
};
// Polaroids oben rechts: zuerst die im Upload-Panel gewählten Fotos, dann neueste Reisen, dann Platzhalter
type Card = { img: string; cap: string; href: string } | null;
const chosen: Card[] = ((site as any).hero ?? [])
  .filter((h: any) => h?.image)
  .slice(0, 3)
  .map((h: any) => ({
    img: h.image,
    cap: (lang === 'en' && h.caption_en) || h.caption_de || '',
    href: localize(h.link || ''),
  }));
const stack: Card[] = [
  ...chosen,
  ...trips.map((trip) => ({ img: trip.data.cover, cap: pick(trip.data, 'title', lang), href: path('trips', lang, trip.id) })),
].slice(0, 3);
while (stack.length < 3) stack.push(null);
const about = pick(site, 'about', lang).split('\n\n')[0];
---
<Base lang={lang} alt={path('home', other)}>
  <section class="hero wrap">
    <div class="hero-text">
      <img class="hero-logo" src="/logo.jpg" alt="Domi's on Tour – live a life you will remember" width="564" height="336" fetchpriority="high" />
      <h1>{tr.hero_title}</h1>
      <p class="lead">{tr.hero_lead}</p>
      <div class="ctas">
        <a class="btn" href="#karte">{tr.hero_cta_map}</a>
        <a class="btn ghost" href={path('trips', lang)}>{tr.hero_cta_trips}</a>
      </div>
    </div>
    <div class="stack">
      {stack.map((card, i) =>
        card ? (
          card.href ? (
            <a class={`polaroid p${i}`} href={card.href}>
              <div class="ph"><Photo src={card.img} alt={card.cap} label={tr.photo_soon} tone={i} eager /></div>
              <span class="cap">{card.cap}</span>
            </a>
          ) : (
            <div class={`polaroid p${i}`}>
              <div class="ph"><Photo src={card.img} alt={card.cap} label={tr.photo_soon} tone={i} eager /></div>
              <span class="cap">{card.cap}</span>
            </div>
          )
        ) : (
          <div class={`polaroid p${i}`} aria-hidden="true">
            <div class="ph"><Photo alt="" tone={i + 1} /></div>
            <span class="cap">{lang === 'de' ? 'bald mehr' : 'more soon'}</span>
          </div>
        ),
      )}
    </div>
  </section>

  <section id="karte" class="section map-sec">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>{tr.map_title}</h2>
          <p class="lead">{tr.map_lead}</p>
        </div>
        <dl class="stats">
          <div><dt>{tr.stat_countries}</dt><dd>{mapData.stats.countries}</dd></div>
          <div><dt>{tr.stat_places}</dt><dd>{mapData.pins.filter((p) => p.kind !== 'entry').length}</dd></div>
          <div><dt>{tr.stat_entries}</dt><dd>{entries.length}</dd></div>
        </dl>
      </div>
      <WorldMap data={mapData} lang={lang} label={tr.map_title} status />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>{tr.trips_title}</h2>
          <p class="lead">{tr.trips_lead}</p>
        </div>
        <a href={path('trips', lang)}>{tr.hero_cta_trips}</a>
      </div>
      {trips.length ? (
        <div class="grid">{trips.slice(0, 6).map((trip, i) => <TripCard trip={trip} lang={lang} index={i} />)}</div>
      ) : <p class="muted">{tr.empty_trips}</p>}
    </div>
  </section>

  <section class="section diary-sec">
    <div class="wrap two">
      <div>
        <h2>{tr.latest_diary}</h2>
        <p class="lead">{tr.diary_lead}</p>
        <a href={path('diary', lang)}>{tr.all_entries}</a>
      </div>
      <div>
        {entries.length ? <EntryList entries={entries.slice(0, 3)} lang={lang} /> : <p class="muted">{tr.empty_diary}</p>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap about">
      <p class="hand big">Herr Domi & Frou Domi</p>
      <div class="prose" set:html={md(about)} />
      <a class="btn ghost" href={path('about', lang)}>{tr.nav_about}</a>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(28px, 5vw, 72px); align-items: center; padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(32px, 5vw, 64px); }
  .hero-logo { width: clamp(240px, 27vw, 340px); height: auto; margin: -24px 0 8px -16px; }
  .hero h1 { max-width: 14ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .stack { position: relative; height: clamp(320px, 38vw, 470px); }
  .stack .polaroid { position: absolute; width: 58%; text-decoration: none; color: inherit; transition: transform 0.3s ease; }
  .stack .p0 { right: 6%; top: 4%; transform: rotate(4deg); z-index: 3; }
  .stack .p1 { left: 0; top: 16%; transform: rotate(-7deg); z-index: 2; }
  .stack .p2 { right: 18%; bottom: 0; transform: rotate(-1.5deg); z-index: 1; width: 48%; }
  .stack .polaroid:hover { transform: rotate(0deg) scale(1.02); z-index: 4; }
  .stack .cap { display: block; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .stack { height: 300px; max-width: 420px; width: 100%; margin: 0 auto; }
  }

  .map-sec { padding-top: clamp(24px, 4vw, 48px); }
  .stats { display: flex; gap: clamp(18px, 3vw, 36px); margin: 0; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dt { font-size: 0.9rem; color: var(--ink-soft); }
  .stats dd { margin: 0; font-size: 2.4rem; font-weight: 750; letter-spacing: -0.03em; line-height: 1; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: clamp(28px, 4vw, 48px); }

  .diary-sec { background: rgba(248, 243, 234, 0.55); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .two { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 5vw, 72px); align-items: start; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }

  .about { max-width: 760px; }
  .big { font-size: clamp(2.4rem, 5vw, 3.4rem); color: var(--sea); margin: 0 0 12px; transform: rotate(-2deg); transform-origin: left; }
  .about .btn { margin-top: 8px; }
</style>
