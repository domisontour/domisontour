---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import Photo from '../components/Photo.astro';
import WorldMap from '../components/WorldMap.astro';
import { getEntries, getTrips, pick, isFallback, md, slugOf, excerpt, buildMapData, type Entry } from '../lib/content';
import { path, t, formatDate, type Lang } from '../lib/i18n';

interface Props { lang: Lang; entry: Entry }
const { lang, entry } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const d = entry.data;
const title = pick(d, 'title', lang);
const text = pick(d, 'text', lang);
const trip = (await getTrips()).find((x) => x.id === slugOf(d.trip));
const all = await getEntries();
const i = all.findIndex((e) => e.id === entry.id);
const newer = all[i - 1];
const older = all[i + 1];
const mapData = d.lat != null && d.lng != null ? buildMapData([], [entry], lang) : null;
---
<Base lang={lang} title={title} description={excerpt(text, 155)} alt={path('diary', other, entry.id)} image={d.cover || undefined} active="diary">
  <article class="wrap section">
    <a class="back" href={path('diary', lang)}>{tr.back_diary}</a>
    <header class="head">
      <p class="when"><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date, lang, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</time></p>
      {d.place && <p class="hand where">{d.place}</p>}
      <h1>{title}</h1>
      {trip && <p class="trip">{tr.from_trip}: <a href={path('trips', lang, trip.id)}>{pick(trip.data, 'title', lang)}</a></p>}
    </header>
    {d.cover && <figure class="polaroid cover"><div class="ph wide"><Photo src={d.cover} alt={title} eager sizes="(max-width: 860px) 95vw, 820px" /></div></figure>}
    {isFallback(d, 'text', lang) && <p class="note">{tr.fallback_note}</p>}
    <div class="prose" set:html={md(text)} />
    {d.photos.length > 0 && <div class="gal"><Gallery photos={d.photos} lang={lang} /></div>}
    {mapData && <div class="mini"><WorldMap data={mapData} lang={lang} mode="fit" height="320px" label={d.place || title} /></div>}
    <nav class="pager" aria-label={lang === 'de' ? 'Weitere Einträge' : 'More entries'}>
      {older ? <a href={path('diary', lang, older.id)}>{lang === 'de' ? 'Älterer Eintrag' : 'Older entry'}<span>{pick(older.data, 'title', lang)}</span></a> : <span />}
      {newer && <a class="r" href={path('diary', lang, newer.id)}>{lang === 'de' ? 'Neuerer Eintrag' : 'Newer entry'}<span>{pick(newer.data, 'title', lang)}</span></a>}
    </nav>
  </article>
</Base>
<style>
  article { max-width: 820px; }
  .back { font-size: 0.95rem; display: inline-block; margin-bottom: 22px; }
  .when { color: var(--ink-soft); font-weight: 550; margin: 0; }
  .where { font-size: 2.1rem; color: var(--sea); margin: 0 0 4px; }
  .trip { color: var(--ink-soft); }
  .cover { margin: 28px 0 36px; transform: rotate(-1deg); }
  .cover .wide { aspect-ratio: 3 / 2; }
  .gal { margin-top: 48px; }
  .mini { margin-top: 48px; }
  .pager { display: flex; justify-content: space-between; gap: 20px; margin-top: 64px; padding-top: 24px; border-top: 1px dashed var(--line); }
  .pager a { display: flex; flex-direction: column; font-size: 0.9rem; text-decoration: none; }
  .pager a span { font-size: 1.1rem; font-weight: 650; color: var(--ink); }
  .pager .r { text-align: right; margin-left: auto; }
</style>
