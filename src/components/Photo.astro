---
// Zeigt ein Foto (als schlankes WebP in passender Grösse) oder einen ruhigen Platzhalter
import { imageInfo } from '../lib/images';
interface Props {
  src?: string;
  alt: string;
  label?: string;
  eager?: boolean;
  tone?: number;
  /** Wie breit das Bild auf dem Bildschirm etwa ist (für die Wahl der Bildgrösse) */
  sizes?: string;
}
const { src, alt, label = '', eager = false, tone = 0, sizes = '(max-width: 760px) 90vw, 420px' } = Astro.props;
const tones = ['#e2d8cc', '#dcd6d0', '#e6dccd', '#d9d6cb'];
const bg = tones[Math.abs(tone) % tones.length];
const info = src ? imageInfo(src) : null;
const srcset = info?.variants.map((v) => `${v.src} ${v.w}w`).join(', ');
const fallback = info ? info.variants[Math.min(1, info.variants.length - 1)].src : src;
---
{src ? (
  <img
    src={fallback}
    srcset={srcset}
    sizes={srcset ? sizes : undefined}
    width={info?.w}
    height={info?.h}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
) : (
  <div class="ph-empty" style={`background:${bg}`} role="img" aria-label={alt || label}>
    <svg viewBox="0 0 120 80" aria-hidden="true">
      <circle cx="88" cy="22" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/>
      <path d="M6 70 L38 34 L56 52 L72 40 L114 70" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
    </svg>
    {label && <span aria-hidden="true">{label}</span>}
  </div>
)}
<style>
  img { width: 100%; height: 100%; object-fit: cover; }
  .ph-empty { width: 100%; height: 100%; display: grid; place-items: center; align-content: center; gap: 4px; color: rgba(43, 42, 38, 0.38); }
  .ph-empty svg { width: 42%; max-width: 120px; }
  .ph-empty span { font-family: var(--hand); font-size: 1.35rem; color: rgba(43, 42, 38, 0.5); }
</style>
