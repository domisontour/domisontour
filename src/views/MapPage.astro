---
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.astro';
import { getTrips, getEntries, buildMapData, countryName, visitedCountryCodes } from '../lib/content';
import { path, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const trips = await getTrips();
const entries = await getEntries();
const data = buildMapData(trips, entries, lang, { withPlaces: true });
const names = visitedCountryCodes(trips).map((c) => countryName(c, lang)).sort((a, b) => a.localeCompare(b, lang));
---
<Base lang={lang} title={tr.map_title} description={tr.map_lead} alt={path('map', other)} active="map">
  <section class="wrap section">
    <h1>{tr.map_title}</h1>
    <p class="lead">{tr.map_lead}</p>
    <div class="legend">
      <span><i class="k sea"></i>{lang === 'de' ? 'Besuchter Ort' : 'Place visited'}</span>
      <span><i class="k plan"></i>{lang === 'de' ? 'Geplanter Ort' : 'Planned place'}</span>
      <span><i class="k rose"></i>{lang === 'de' ? 'Tagebucheintrag' : 'Diary entry'}</span>

    </div>
    <WorldMap data={data} lang={lang} label={tr.map_title} height="clamp(460px, 76vh, 800px)" status />
    {names.length > 0 && <p class="hand list">{names.join(', ')}</p>}
  </section>
</Base>
<style>
  .legend { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 0 0 18px; font-size: 0.92rem; color: var(--ink-soft); }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .k { width: 14px; height: 14px; border-radius: 50%; display: inline-block; }
  .sea { background: var(--ink); } .plan { background: var(--linen); border: 2px dashed #8a8d6c; } .rose { background: #c6964f; } .land { background: var(--blush); border-radius: 3px; }
  .list { font-size: 1.9rem; color: var(--sea); margin-top: 24px; }
</style>
