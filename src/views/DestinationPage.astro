---
import Base from '../layouts/Base.astro';
import TripCard from '../components/TripCard.astro';
import EntryList from '../components/EntryList.astro';
import WorldMap from '../components/WorldMap.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { site, pick, md, countryNumeric, type MapData } from '../lib/content';
import { type Destination } from '../lib/destinations';
import { path, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang; dest: Destination }
const { lang, dest } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const de = lang === 'de';
const d = dest.entry?.data;
const name = dest.name[lang];
const s = site as any;

// Text-Abschnitte aus dem Upload-Panel (nur anzeigen, wenn befüllt)
const txt = (f: string) => (d ? pick(d, f, lang) : '');
const sections = [
  { id: 'reisezeit', label: tr.tab_best_time, html: md(txt('best_time')) },
  { id: 'unterkuenfte', label: tr.tab_stay, html: md(txt('stay')) },
  { id: 'mietwagen', label: tr.tab_car, html: md(txt('car')) },
  { id: 'packliste', label: tr.tab_packing, html: md(txt('packing')) },
  { id: 'kosten', label: tr.tab_costs, html: md(txt('costs')) },
  { id: 'tipps', label: tr.tab_tips, html: md(txt('tips')) },
].filter((x) => x.html);
const routesHtml = md(txt('routes'));
const highlights = d?.highlights ?? [];
const places = dest.places[lang];

const intro =
  txt('intro') ||
  (de
    ? `und waren schon in ${name}${places.length ? `, unter anderem in ${places.slice(0, 3).map((p) => p.name).join(', ')}` : ''}. Hier sammeln wir unsere Erfahrungen und Tipps, damit eure Reise einfacher wird.`
    : `and we have travelled ${name}${places.length ? `, including ${places.slice(0, 3).map((p) => p.name).join(', ')}` : ''}. This is where we collect our experiences and tips to make your trip easier.`);

const tabs = [
  { id: 'ueberblick', label: tr.tab_overview },
  (dest.trips.length || routesHtml) && { id: 'routen', label: tr.tab_trips },
  highlights.length && { id: 'highlights', label: tr.tab_highlights },
  places.length && { id: 'orte', label: tr.tab_places },
  ...sections,
  dest.entries.length && { id: 'tagebuch', label: tr.tab_diary },
].filter(Boolean) as { id: string; label: string }[];

const num = countryNumeric(dest.code);
const map: MapData = {
  countries: [num],
  states: [],
  plannedCountries: [],
  plannedStates: [],
  routes: dest.trips.filter((x) => x.data.show_route && x.data.stops.length > 1).map((x) => ({ coords: x.data.stops.map((p) => [p.lng, p.lat] as [number, number]) })),
  pins: places.map((p) => ({ lat: p.lat, lng: p.lng, title: p.name, sub: name, href: '', image: '', kind: 'place' as const })),
  stats: { countries: 1, countriesTotal: 195, states: 0, statesTotal: 50, plannedCountries: 0, plannedStates: 0 },
};
const links = (s.planning_links ?? []) as any[];
const hasGuide = sections.length || highlights.length || routesHtml || dest.trips.length;
---
<Base lang={lang} title={name} description={intro.slice(0, 155)} alt={path('dest', other, dest.slug[other])} image={dest.cover || undefined} active="dest">
  <div class="dest-head">
    <div class="wrap">
      <nav class="tabs" aria-label={name}>
        <a class="crumb" href={path('dest', lang)}>
          <span class="hand">{name}</span>
          <svg viewBox="0 0 8 14" width="8" height="14" aria-hidden="true"><path d="m1 1 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        </a>
        <ul>{tabs.map((x) => <li><a href={`#${x.id}`}>{x.label}</a></li>)}</ul>
      </nav>
    </div>
  </div>

  <section id="ueberblick" class="wrap overview">
    <div class="intro">
      <figure class="intro-photo">
        <div class="ph"><Photo src={s.photo_couple} alt="Herr Domi und Frou Domi" eager sizes="220px" /></div>
        <span class="hello hand">{tr.intro_hi}</span>
      </figure>
      <div class="intro-text">
        <h1 class="sr">{name}</h1>
        <h2>{tr.intro_title}</h2>
        <div class="prose" set:html={md(intro)} />
        <div class="intro-foot">
          <div class="socials">
            {s.instagram && <a href={s.instagram} target="_blank" rel="me noopener" aria-label="Instagram"><Icon name="instagram" /></a>}
            {s.youtube && <a href={s.youtube} target="_blank" rel="me noopener" aria-label="YouTube"><Icon name="youtube" /></a>}
            {s.tiktok && <a href={s.tiktok} target="_blank" rel="me noopener" aria-label="TikTok"><Icon name="tiktok" /></a>}
          </div>
          <a class="more" href={path('about', lang)}>{tr.more_about}</a>
        </div>
      </div>
    </div>

    {links.length > 0 && (
      <aside class="plan" aria-label={tr.planning}>
        <p class="plan-h">{tr.planning}</p>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener sponsored">
                <span class="ic"><Icon name={l.icon || 'link'} /></span>
                <span class="tx"><small>{l.provider}</small>{(lang === 'en' && l.label_en) || l.label_de}</span>
                <span class="arr"><Icon name="link" size={16} /></span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </section>

  {!hasGuide && <div class="wrap"><p class="note">{tr.guide_soon}</p></div>}

  {(dest.trips.length > 0 || routesHtml) && (
    <section id="routen" class="wrap block">
      <h2>{tr.tab_trips}</h2>
      {routesHtml && <div class="prose" set:html={routesHtml} />}
      {dest.trips.length > 0 && <div class="grid">{dest.trips.map((trip, i) => <TripCard trip={trip} lang={lang} index={i} />)}</div>}
    </section>
  )}

  {highlights.length > 0 && (
    <section id="highlights" class="wrap block">
      <h2>{tr.tab_highlights}</h2>
      <div class="hl">
        {highlights.map((h, i) => (
          <article class="hl-card">
            {h.image && <div class="hl-img"><Photo src={h.image} alt={pick(h, 'title', lang)} tone={i} sizes="(max-width: 760px) 90vw, 380px" /></div>}
            <div class="hl-body">
              <h3>{pick(h, 'title', lang)}</h3>
              {pick(h, 'text', lang) && <div class="prose" set:html={md(pick(h, 'text', lang))} />}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {places.length > 0 && (
    <section id="orte" class="wrap block">
      <h2>{tr.places_title}</h2>
      <div class="places">
        <ul class="place-list">{places.map((p) => <li>{p.name}</li>)}</ul>
        <WorldMap data={map} lang={lang} mode="fit" height="clamp(340px, 52vh, 500px)" label={tr.places_title} />
      </div>
    </section>
  )}

  {sections.map((x) => (
    <section id={x.id} class="wrap block">
      <h2>{x.label}</h2>
      <div class="prose" set:html={x.html} />
    </section>
  ))}

  {dest.entries.length > 0 && (
    <section id="tagebuch" class="wrap block">
      <h2>{tr.tab_diary}</h2>
      <EntryList entries={dest.entries} lang={lang} />
    </section>
  )}
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .dest-head { position: sticky; top: 72px; z-index: 40; background: rgba(236, 231, 227, 0.94); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .tabs { display: flex; align-items: flex-end; gap: 14px; padding-top: 18px; border-bottom: 1.5px solid var(--gold); overflow-x: auto; scrollbar-width: thin; }
  .crumb { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; padding: 0 6px 10px 0; flex-shrink: 0; }
  .crumb .hand { font-size: 2.1rem; line-height: 1; }
  .tabs ul { list-style: none; display: flex; gap: 6px; margin: 0; padding: 0; }
  .tabs li a {
    display: block; white-space: nowrap; padding: 10px 18px 9px; color: var(--ink); text-decoration: none; font-weight: 550;
    border: 1.5px solid var(--gold); border-bottom: 0; border-radius: 12px 12px 0 0; background: var(--linen);
  }
  .tabs li a:hover { background: #f6efe6; }

  .overview { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 28px; padding-top: 32px; scroll-margin-top: 150px; }
  .intro { background: #f1e6d6; border-radius: 28px; padding: clamp(22px, 3vw, 36px); display: grid; grid-template-columns: 220px 1fr; gap: clamp(20px, 3vw, 40px); align-items: center; }
  .intro-photo { position: relative; margin: 0; }
  .intro-photo .ph { aspect-ratio: 1 / 1; border-radius: 46% 54% 48% 52% / 52% 44% 56% 48%; overflow: hidden; border: 4px solid var(--linen); box-shadow: var(--shadow); }
  .hello { position: absolute; top: -10px; right: -6px; background: var(--linen); color: var(--gold-deep); font-size: 1.7rem; padding: 4px 12px 6px; border-radius: 10px; box-shadow: var(--shadow); transform: rotate(-4deg); }
  .intro-text h2 { font-size: clamp(1.5rem, 2.4vw, 1.9rem); margin-bottom: 10px; }
  .intro-text .prose { font-size: 1.05rem; }
  .intro-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 6px; }
  .socials { display: flex; gap: 8px; }
  .socials a { width: 44px; height: 44px; border-radius: 50%; background: var(--linen); color: var(--ink); display: grid; place-items: center; }
  .socials a:hover { color: var(--gold-deep); }
  .more { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--serif); font-size: 1.15rem; color: var(--ink); text-decoration-color: var(--gold); text-decoration-thickness: 2px; }

  .plan { background: var(--linen); border-radius: 28px; padding: 22px; align-self: start; box-shadow: var(--shadow); }
  .plan-h { font-family: var(--serif); font-size: 1.25rem; margin: 0 0 12px 6px; }
  .plan ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .plan a { display: grid; grid-template-columns: 46px 1fr auto; align-items: center; gap: 12px; padding: 10px 14px 10px 10px; border-radius: 999px; background: var(--sand); color: var(--ink); text-decoration: none; }
  .plan a:hover { background: #e6dfd8; }
  .ic { width: 46px; height: 46px; border-radius: 50%; background: var(--ink); color: var(--linen); display: grid; place-items: center; }
  .tx { display: flex; flex-direction: column; font-weight: 650; font-size: 1.05rem; line-height: 1.2; }
  .tx small { font-weight: 500; font-size: 0.75rem; color: var(--ink-soft); }
  .arr { color: var(--gold-deep); }

  @media (max-width: 960px) {
    .overview { grid-template-columns: 1fr; }
    .intro { grid-template-columns: 1fr; text-align: left; }
    .intro-photo { max-width: 200px; }
  }

  .block { padding-top: clamp(48px, 7vw, 80px); scroll-margin-top: 150px; }
  .note { margin-top: 28px; }
  .grid { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: clamp(28px, 4vw, 48px); }
  .hl { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px; margin-top: 18px; }
  .hl-card { background: var(--linen); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .hl-img { aspect-ratio: 4 / 3; }
  .hl-body { padding: 18px 20px 8px; }
  .hl-body .prose { font-size: 1rem; }
  .places { display: grid; grid-template-columns: 240px 1fr; gap: 32px; align-items: start; margin-top: 18px; }
  .place-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 2px; }
  .place-list li { font-family: var(--serif); font-size: 1.08rem; padding: 8px 0; border-bottom: 1px dashed var(--line); }
  @media (max-width: 760px) { .places { grid-template-columns: 1fr; } .dest-head { top: 96px; } }
</style>
