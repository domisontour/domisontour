{
  // Cloudflare: statische Webseite aus dem Ordner dist ausliefern
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "domisontour",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "www.domisontour.ch", "custom_domain": true },
    { "pattern": "domisontour.ch", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
