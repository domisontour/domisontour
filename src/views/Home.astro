---
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.astro';
import TripCard from '../components/TripCard.astro';
import EntryList from '../components/EntryList.astro';
import Photo from '../components/Photo.astro';
import { getTrips, getEntries, buildMapData, pick, md, site } from '../lib/content';
import { destinationsByContinent, plannedByCountry } from '../lib/destinations';
import { path, t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';

const trips = await getTrips();
const entries = await getEntries();
const mapData = buildMapData(trips, entries, lang, { withPlaces: true });
// Deutsche Links auf der englischen Seite automatisch umschreiben
const localize = (href: string) => {
  if (lang === 'de' || !href.startsWith('/') || href.startsWith('/en/')) return href;
  return '/en' + href.replace(/^\/reisen\//, '/trips/').replace(/^\/tagebuch\//, '/diary/').replace(/^\/karte\//, '/map/').replace(/^\/ueber-uns\//, '/about/');
};
// Polaroids oben rechts: zuerst die im Upload-Panel gewählten Fotos, dann neueste Reisen, dann Platzhalter
type Card = { img: string; cap: string; href: string } | null;
const chosen: Card[] = ((site as any).hero ?? [])
  .filter((h: any) => h?.image)
  .slice(0, 3)
  .map((h: any) => ({
    img: h.image,
    cap: (lang === 'en' && h.caption_en) || h.caption_de || '',
    href: localize(h.link || ''),
  }));
const stack: Card[] = [
  ...chosen,
  ...trips.map((trip) => ({ img: trip.data.cover, cap: pick(trip.data, 'title', lang), href: path('trips', lang, trip.id) })),
].slice(0, 3);
while (stack.length < 3) stack.push(null);
const about = pick(site, 'about', lang).split('\n\n')[0];
const groups = await destinationsByContinent(lang);
const planned = await plannedByCountry(lang);
const de = lang === 'de';
---
<Base lang={lang} alt={path('home', other)}>
  <section class="hero wrap">
    <div class="hero-text">
      <img class="hero-logo" src="/logo.jpg" alt="Domi's on Tour – live a life you will remember" width="564" height="336" fetchpriority="high" />
      <h1>{pick(site, 'hero_title', lang) || tr.hero_title}</h1>
      <p class="lead">{pick(site, 'hero_lead', lang) || tr.hero_lead}</p>
      <div class="ctas">
        <a class="btn" href="#karte">{tr.hero_cta_map}</a>
        <a class="btn ghost" href={path('trips', lang)}>{tr.hero_cta_trips}</a>
      </div>
    </div>
    <div class="stack">
      {stack.map((card, i) =>
        card ? (
          card.href ? (
            <a class={`polaroid p${i}`} href={card.href}>
              <div class="ph"><Photo src={card.img} alt={card.cap} label={tr.photo_soon} tone={i} eager={i === 0} sizes="(max-width: 860px) 60vw, 340px" /></div>
              <span class="cap">{card.cap}</span>
            </a>
          ) : (
            <div class={`polaroid p${i}`}>
              <div class="ph"><Photo src={card.img} alt={card.cap} label={tr.photo_soon} tone={i} eager={i === 0} sizes="(max-width: 860px) 60vw, 340px" /></div>
              <span class="cap">{card.cap}</span>
            </div>
          )
        ) : (
          <div class={`polaroid p${i}`} aria-hidden="true">
            <div class="ph"><Photo alt="" tone={i + 1} /></div>
            <span class="cap">{lang === 'de' ? 'bald mehr' : 'more soon'}</span>
          </div>
        ),
      )}
    </div>
  </section>

  <section id="karte" class="section map-sec">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>{tr.map_title}</h2>
          <p class="lead">{tr.map_lead}</p>
        </div>
      </div>
      <WorldMap data={mapData} lang={lang} label={tr.map_title} status />
    </div>
  </section>

  <section class="section dest-sec" aria-labelledby="ziele-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 id="ziele-h">{tr.dest_title}</h2>
          <p class="lead">{tr.dest_lead}</p>
        </div>
        <a class="tlink" href={path('dest', lang)}>{tr.dest_all}</a>
      </div>
      <div class="index">
        {groups.map((g) => (
          <div class="index-col">
            <h3 class="hand">{g.name}</h3>
            <ul>
              {g.items.map((d) => (
                <li>
                  <a href={path('dest', lang, d.slug[lang])}>
                    <span class="ix-name">{d.name[lang]}</span>
                    {d.places[lang].length > 0 && <span class="ix-sub">{d.places[lang].length} {de ? (d.places[lang].length === 1 ? 'Ort' : 'Orte') : (d.places[lang].length === 1 ? 'place' : 'places')}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {planned.length > 0 && (
    <section class="section next-sec" aria-labelledby="next-h">
      <div class="wrap">
        <p class="hand kicker" aria-hidden="true">{de ? 'Koffer schon halb gepackt' : 'Bags half packed'}</p>
        <h2 id="next-h">{de ? 'Als Nächstes' : 'Up next'}</h2>
        <ol class="route">
          {planned.map((p) => (
            <li>
              <svg class="rpin" viewBox="0 0 24 32" width="22" height="30" aria-hidden="true"><path d="M12 1C6 1 1.5 5.4 1.5 11.2 1.5 19 12 31 12 31s10.5-12 10.5-19.8C22.5 5.4 18 1 12 1z" fill="var(--linen)" stroke="#8a8d6c" stroke-width="2" stroke-dasharray="3 2"/><circle cx="12" cy="11" r="3.5" fill="#8a8d6c"/></svg>
              {p.when && <span class="r-when">{p.when}</span>}
              <span class="r-name">{p.name}</span>
              {p.places.length > 0 && <span class="r-places hand">{p.places.join(', ')}</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {trips.length > 0 && (
    <section class="section" aria-labelledby="trips-h">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2 id="trips-h">{de ? 'Reiseberichte' : 'Trip reports'}</h2>
            <p class="lead">{tr.trips_lead}</p>
          </div>
          <a class="tlink" href={path('trips', lang)}>{tr.hero_cta_trips}</a>
        </div>
        <div class="grid">{trips.slice(0, 3).map((trip, i) => <TripCard trip={trip} lang={lang} index={i} />)}</div>
      </div>
    </section>
  )}

  {entries.length > 0 && (
    <section class="section diary-sec">
      <div class="wrap two">
        <div>
          <h2>{tr.latest_diary}</h2>
          <p class="lead">{tr.diary_lead}</p>
          <a class="tlink" href={path('diary', lang)}>{tr.all_entries}</a>
        </div>
        <div><EntryList entries={entries.slice(0, 3)} lang={lang} /></div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap about">
      <p class="hand big">Herr Domi & Frou Domi</p>
      <div class="prose" set:html={md(about)} />
      <a class="btn ghost" href={path('about', lang)}>{tr.nav_about}</a>
    </div>
  </section>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(28px, 5vw, 72px); align-items: center; padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(32px, 5vw, 64px); }
  .hero-logo { width: clamp(240px, 27vw, 340px); height: auto; margin: -24px 0 8px -16px; }
  .hero h1 { max-width: 14ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .stack { position: relative; height: clamp(320px, 38vw, 470px); }
  .stack .polaroid { position: absolute; width: 58%; text-decoration: none; color: inherit; transition: transform 0.3s ease; }
  .stack .p0 { right: 6%; top: 4%; transform: rotate(4deg); z-index: 3; }
  .stack .p1 { left: 0; top: 16%; transform: rotate(-7deg); z-index: 2; }
  .stack .p2 { right: 18%; bottom: 0; transform: rotate(-1.5deg); z-index: 1; width: 48%; }
  .stack .polaroid:hover { transform: rotate(0deg) scale(1.02); z-index: 4; }
  .stack .cap { display: block; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; }
    .stack { height: 300px; max-width: 420px; width: 100%; margin: 0 auto; }
  }

  .map-sec { padding-top: clamp(24px, 4vw, 48px); }
  /* Reiseziel-Verzeichnis im Stil eines Reisetagebuch-Registers */
  .index { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 8px clamp(24px, 4vw, 56px); border-top: 1.5px solid var(--gold); padding-top: 20px; }
  .index-col h3 { font-size: 2rem; color: var(--gold-deep); margin: 0 0 4px; letter-spacing: 0; }
  .index-col ul { list-style: none; margin: 0 0 18px; padding: 0; }
  .index-col a { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; min-height: 44px; padding: 8px 0; border-bottom: 1px dashed var(--line); color: var(--ink); text-decoration: none; }
  .ix-name { font-family: var(--serif); font-size: 1.12rem; }
  .ix-sub { font-size: 0.82rem; color: var(--ink-soft); white-space: nowrap; }
  .index-col a:hover .ix-name, .index-col a:focus-visible .ix-name { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; }

  /* Als Nächstes: geplante Ziele als gestrichelte Route */
  .next-sec { padding-top: 0; }
  .dest-sec { padding-top: clamp(24px, 4vw, 48px); }
  .kicker { font-size: 1.8rem; color: var(--gold-deep); margin: 0; transform: rotate(-2deg); transform-origin: left; }
  .route { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 1fr); position: relative; }
  .route::before { content: ''; position: absolute; left: 11px; right: 11px; top: 14px; border-top: 2px dashed var(--gold); }
  .route li { position: relative; display: flex; flex-direction: column; gap: 4px; padding-right: 16px; }
  .rpin { position: relative; z-index: 1; margin-bottom: 10px; background: var(--sand); }
  .r-when { font-size: 0.82rem; font-weight: 650; letter-spacing: 0.02em; color: var(--gold-deep); }
  .r-name { font-family: var(--serif); font-size: 1.3rem; }
  .r-places { font-size: 1.5rem; color: var(--ink-soft); line-height: 1.1; }
  @media (max-width: 760px) {
    .route { grid-auto-flow: row; gap: 18px; padding-left: 40px; }
    .route::before { left: 11px; right: auto; top: 10px; bottom: 10px; border-top: 0; border-left: 2px dashed var(--gold); }
    .route li { padding-right: 0; }
    .rpin { position: absolute; left: -40px; top: 0; margin: 0; }
  }

  .stats { display: flex; gap: clamp(18px, 3vw, 36px); margin: 0; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dt { font-size: 0.9rem; color: var(--ink-soft); }
  .stats dd { margin: 0; font-size: 2.4rem; font-weight: 750; letter-spacing: -0.03em; line-height: 1; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: clamp(28px, 4vw, 48px); }

  .diary-sec { background: rgba(248, 243, 234, 0.55); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .two { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 5vw, 72px); align-items: start; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }

  .about { max-width: 760px; }
  .big { font-size: clamp(2.4rem, 5vw, 3.4rem); color: var(--sea); margin: 0 0 12px; transform: rotate(-2deg); transform-origin: left; }
  .about .btn { margin-top: 8px; }
</style>
