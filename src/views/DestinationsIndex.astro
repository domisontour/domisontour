---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import TripCard from '../components/TripCard.astro';
import { destinationsByContinent } from '../lib/destinations';
import { getTrips } from '../lib/content';
import { path, t, type Lang } from '../lib/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const groups = await destinationsByContinent(lang);
const trips = await getTrips();
---
<Base lang={lang} title={tr.dest_title} description={tr.dest_lead} alt={path('dest', other)} active="dest">
  <section class="wrap section">
    <h1>{tr.dest_title}</h1>
    <p class="lead">{tr.dest_lead}</p>
    {groups.map((g) => (
      <div class="cont">
        <h2>{g.name}</h2>
        <ul class="tiles">
          {g.items.map((d, i) => (
            <li>
              <a href={path('dest', lang, d.slug[lang])} class="tile">
                <span class="tile-img"><Photo src={d.cover} alt="" tone={i} sizes="64px" /></span>
                <span class="tile-name">{d.name[lang]}</span>
                {d.places[lang].length > 0 && <span class="tile-sub">{d.places[lang].slice(0, 3).map((p) => p.name).join(', ')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
  {trips.length > 0 && (
    <section class="wrap section reports">
      <h2>{tr.dest_trips_reports}</h2>
      <div class="grid">{trips.map((trip, i) => <TripCard trip={trip} lang={lang} index={i} />)}</div>
    </section>
  )}
</Base>
<style>
  .cont { margin-top: 44px; }
  .cont h2 { font-size: 1.7rem; padding-bottom: 10px; border-bottom: 1.5px solid var(--gold); }
  .tiles { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 16px; }
  .tile { display: grid; grid-template-columns: 64px 1fr; grid-template-rows: auto auto; column-gap: 12px; align-items: center; padding: 10px; border-radius: 14px; background: var(--linen); color: var(--ink); text-decoration: none; box-shadow: var(--shadow); height: 100%; }
  .tile:hover { outline: 1.5px solid var(--gold); }
  .tile-img { grid-row: span 2; width: 64px; height: 64px; border-radius: 10px; overflow: hidden; display: block; }
  .tile-name { font-family: var(--serif); font-size: 1.12rem; align-self: end; }
  .tile-sub { font-size: 0.82rem; color: var(--ink-soft); align-self: start; line-height: 1.3; }
  .tile:not(:has(.tile-sub)) .tile-name { grid-row: span 2; align-self: center; }
  .reports { padding-top: 0; }
  .grid { margin-top: 24px; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: clamp(28px, 4vw, 48px); }
</style>
